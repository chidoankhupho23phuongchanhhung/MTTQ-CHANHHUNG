# =================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG & API - MẶT TRẬN SỐ PHƯỜNG CHÁNH HƯNG
# =================================================================
# Hướng dẫn: Sao chép file này thành file `.env.local` và điền các API Key của bạn.
# Lệnh nhanh: cp .env.example .env.local

# -----------------------------------------------------------------
# 1. GOOGLE GEMINI AI API (Trợ lý AI, soạn thảo văn bản, tóm tắt)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 2. FACEBOOK GRAPH API (Hiển thị tin tức tự động từ Fanpage MTTQ)
# Lấy Access Token tại: https://developers.facebook.com/tools/explorer/
# -----------------------------------------------------------------
NEXT_PUBLIC_FB_PAGE_ID=61580661372890
NEXT_PUBLIC_FB_ACCESS_TOKEN=your_facebook_access_token_here

# -----------------------------------------------------------------
# 3. GOOGLE SHEETS API (Lịch công tác tuần tự động)
# ID bảng tính công khai từ link docs.google.com/spreadsheets/d/<ID>
# -----------------------------------------------------------------
GOOGLE_SHEET_ID=1h76CSsBYTZHFuCZ_pobjO_ZZF3tdZYH4Uql8rSZ-MGM

# -----------------------------------------------------------------
